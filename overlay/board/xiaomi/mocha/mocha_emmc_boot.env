stdin=serial
stdout=serial,vidconsole
stderr=serial,vidconsole
bootcmd=run boot_debian; echo Debian boot unavailable - USB Fastboot; fastboot usb 0
boot_debian=setenv fdt_high ffffffff; setenv initrd_high ffffffff; if mmc dev 0 && ext4load mmc 0#APP 80007fc0 /boot/uImage-desktop && ext4load mmc 0#APP 88000000 /boot/initramfs.cpio.gz; then setenv rdsize ${filesize}; if ext4load mmc 0#APP 8c000000 /boot/mocha-desktop.dtb; then fdt addr 8c000000; fdt resize 10000; setenv bootargs mem=1700M maxcpus=4 root=/dev/mmcblk0p26 rootfstype=ext4 rootwait rw console=ttyS0,115200n8 console=tty0 panic=30 loglevel=6 clk_ignore_unused regulator_ignore_unused earlycon=mochafb; bootm 80007fc0 88000000:${rdsize} 8c000000; fi; fi
