stdin=serial
stdout=serial,vidconsole
stderr=serial,vidconsole
sample_power_key=if test "${mocha_desktop_requested}" != "1"; then setenv mocha_desktop_requested 0; if gpio input Q0; then setenv mocha_desktop_requested 1; fi; fi
boot_debian=setenv fdt_high ffffffff; setenv initrd_high ffffffff; if mmc dev 0 && ext4load mmc 0#APP 80007fc0 /boot/uImage-desktop && ext4load mmc 0#APP 88000000 /boot/initramfs.cpio.gz; then setenv rdsize ${filesize}; if ext4load mmc 0#APP 8c000000 /boot/mocha-desktop.dtb; then fdt addr 8c000000; fdt resize 10000; setenv bootargs mem=1700M maxcpus=4 root=/dev/mmcblk0p26 rootfstype=ext4 rootwait rw console=ttyS0,115200n8 console=tty0 panic=30 loglevel=6 clk_ignore_unused regulator_ignore_unused earlycon=mochafb,moze mocha_boot_animation=1 mocha_desktop_requested=${mocha_desktop_requested} mocha_power_key_early=${mocha_power_key_early}; bootm 80007fc0 88000000:${rdsize} 8c000000; fi; fi
